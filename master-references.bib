@article{vanderplasTestingStatisticalCharts2020,
  ids = {vanderplasTestingStatisticalCharts2020a},
  title = {Testing {{Statistical Charts}}: {{What Makes}} a {{Good Graph}}?},
  shorttitle = {Testing {{Statistical Charts}}},
  author = {Vanderplas, Susan and Cook, Dianne and Hofmann, Heike},
  year = {2020},
  month = mar,
  journal = {Annual Review of Statistics and Its Application},
  volume = {7},
  number = {1},
  pages = {annurev-statistics-031219-041252},
  issn = {2326-8298, 2326-831X},
  doi = {10/ggnv7t},
  url = {https://www.annualreviews.org/doi/10.1146/annurev-statistics-031219-041252},
  urldate = {2020-02-10},
  abstract = {It has been approximately 100 years since the very first formal experimental evaluations of statistical charts were conducted. In that time, technological changes have impacted both our charts and our testing methods, resulting in a dizzying array of charts, many different taxonomies to classify graphics, and several different philosophical approaches to testing the efficacy of charts and graphs experimentally. Once rare, charts and graphical displays are now everywhere{\textemdash}but do they help us understand? In this article we review the history of graphical testing across disciplines, discuss different direct approaches to testing graphics, and contrast direct tests with visual inference, which requires that the viewer determine both the question and the answer. Examining the past 100 years of graphical testing, we summarize best practices for creating effective graphics and discuss what the future holds for graphics and empirical testing of interactive statistical visualizations.},
  copyright = {All rights reserved},
  langid = {english},
  keywords = {chart design,graphics,perception,user testing,visual inference,visualization},
  annotation = {00000},
  file = {/home/susan/Nextcloud/Zotero/storage/BQSFGWQD/Vanderplas et al. - 2020 - Testing Statistical Charts What Makes a Good Grap.pdf;/home/susan/Nextcloud/Zotero/storage/I5F3CXM3/Vanderplas et al. - 2020 - Testing Statistical Charts What Makes a Good Grap.pdf}
}

