  year = {2018},
  month = feb,
  journal = {Ecosystem services},
  volume = {29},
  number = {part C},
  pages = {499--514},
  publisher = {Elsevier B.V},
  address = {AMSTERDAM},
  issn = {2212-0416},
  abstract = {{$\bullet$}24 real-world case studies show the added value of combining ES assessment methods.{$\bullet$}Combinations integrate across value types, ES, decision contexts and supply/demand.{$\bullet$}Stakeholder methods are key: learning stimulates innovation and understanding.{$\bullet$}Hybrid approaches overcome weaknesses in individual methods.{$\bullet$}Method comparison addresses uncertainty and highlights flaws and bias. The Ecosystem Services (ES) concept highlights the varied contributions the environment provides to humans and there are a wide range of methods/tools available to assess ES. However, in real-world decision contexts a single tool is rarely sufficient and methods must be combined to meet practitioner needs. Here, results from the OpenNESS project are presented to illustrate the methods selected to meet the needs of 24 real-world case studies and better understand why and how methods are combined to meet practical needs. Results showed that within the cases methods were combined to: i) address a range of ES; ii) assess both supply and demand of ES; iii) assess a range of value types; iv) reach different stakeholder groups v) cover weaknesses in other methods used and vi) to meet specific decision context needs. Methods were linked in a variety of ways: i) as input--output chains of methods; ii) through learning; iii) through method development and iv) through comparison/triangulation of results. The paper synthesises these case study-based experiences to provide insight to others working in practical contexts as to where, and in what contexts, different methods can be combined and how this can add value to case study analyses.},
  copyright = {2017},
  langid = {english},
  keywords = {Case studies,Ecology,Ecosystem services,Environmental sciences,Human beings,Learning}
}

