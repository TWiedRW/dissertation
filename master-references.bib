	note = {Publisher: {SAGE} Publications Inc},
	file = {SAGE PDF Full Text:/home/susan/Nextcloud/Zotero/storage/2RXSIFIY/Maineri et al. - 2021 - Slider Bars in Multi-Device Web Surveys.pdf:application/pdf},
}

