  keywords = {Agriculture,Agronomy,Allelopathy,Biodiversity,Biomass,Botany,Chenopodium album,Common sunflower,Corn,Cover crops,Crop residue management,Crop residues,Crop rotation,Cropping systems,Crops,Energy crops,Grasses,Indian mallow,Loam soils,Methodology,Methods,Nebraska,Organic farming,Organic gardening,Plows,Soybean,Sunflowers,Weed control,Weeds}
}

@article{cdi_bioone_primary_10_2111_REM_D_10_00010_1,
  title = {Defoliation Effects on Herbage Production and Root Growth of Wet Meadow Forage Species},
  author = {Volesky, Jerry D. and Schacht, Walter H. and Koehler, Ann E. and Blankenship, Erin and Reece, Patrick E.},
