@article{cdi_scopus_primary_2_s2_0_65349121395,
  title = {On-Plant Survival and Inheritance of Resistance to {{Cry1Ab}} Toxin from {{Bacillus}} Thuringiensis in a Field-Derived Strain of {{European}} Corn Borer, {{Ostrinia}} Nubilalis},
  author = {Crespo, Andr{\'e} LB and Spencer, Terence A and Alves, Analiza P and Hellmich, Richard L and Blankenship, Erin E and Magalh{\~a}es, Leonardo C and Siegfried, Blair D},
  year = {2009},
  month = oct,
  journal = {Pest management science},
  volume = {65},
