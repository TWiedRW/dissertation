@article{cdi_webofscience_primary_000824036600001CitationCount,
  title = {Genomic Prediction Accuracy of Stripe Rust in Six Spring Wheat Populations by Modeling Genotype by Environment Interaction},
  author = {Semagn, Kassa and Iqbal, Muhammad and Jarquin, Diego and Randhawa, Harpinder and Aboukhaddour, Reem and Howard, Reka and Ciechanowska, Izabela and Farzand, Momna and Dhariwal, Raman and Hiebert, Colin W. and N'Diaye, Amidou and Pozniak, Curtis and Spaner, Dean},
