  author = {Hildreth, Aaron M. and Hygnstrom, Scott E. and Blankenship, Erin E. and VerCauteren, Kurt C.},
  year = {2012},
  month = mar,
  journal = {Wildlife Society bulletin},
  volume = {36},
  number = {1},
  pages = {199--203},
  publisher = {John Wiley \& Sons, Inc},
  address = {Hoboken, USA},
  issn = {1938-5463},
  abstract = {White-tailed deer (Odocoileus virginianus) damage agricultural crops, often leading to significant economic losses for farmers. We used poly-mesh fence with wings to separate good deer cover from agricultural fields where crop damage by deer occurred primarily along this edge. In these cases, complete enclosure of the field with fencing may be unnecessary. The design used a 2.13-m-high polypropylene mesh fence erected along the wooded edge of a field with either 50-m or 150-m wings extending perpendicular from the fence line and wooded habitat. Fences reduced deer damage in cornfields 13.51,6= {$\infty$},P{\textexclamdown} 0.001). Average yield in fenced fields (10,211 kg/ha) was 1,708 kg/ha greater than in control fields, which, at US0.155/kg,equalsanetgainofUS265/ha. We found no difference in damage between fences with 50-m and 150-m wings (F 1,1= 0.26,P= 0.695). Costs for materials and labor for erecting partial poly-mesh fences with wings were US5.56/mandUS1.42/m, respectively. Mean total cost for partial poly-mesh fences with 50-m wings would be US60.13/ha/yearovera10-yearperiod,comparedwithUS82.30/ha/year for 150-m wings and US184.16/ha/yearforcompletelyenclosingfields.Expectedsavingsforpartialpoly-meshfenceswith50-mwingsovera10-yearperiodwereUS205/ha/year, as compared with damaged fields without fences. We concluded that poly-mesh fences with 50-m wings were cost-effective at reducing damage by deer to corn. Additional research should be conducted to determine efficacy of the more cost-effective high-tensile and poly-tape fences with wings.},
  copyright = {2012 The Wildlife Society},
  langid = {english},
  keywords = {Biodiversity conservation,Corn,Crops,Deer,Fences,Food crops,White-tailed deer}
}

