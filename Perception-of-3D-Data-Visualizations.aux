\newlabel{fig-sine-illusion-2}{{3.3b}{33}{3D surface with similar features\relax }{figure.caption.24}{}}
\newlabel{sub@fig-sine-illusion-2}{{b}{33}{3D surface with similar features\relax }{figure.caption.24}{}}
\newlabel{fig-sine-illusion-3}{{3.3c}{33}{Perceived vs.~actual length\relax }{figure.caption.24}{}}
