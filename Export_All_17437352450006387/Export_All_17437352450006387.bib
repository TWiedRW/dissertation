  author = {McClung, Nancy M. and Gargano, Julia W. and Park, Ina U. and Whitney, Erin and Abdullah, Nasreen and Ehlers, Sara and Bennett, Nancy M. and Scahill, Mary and Niccolai, Linda M. and Brackney, Monica and Griffin, Marie R. and Pemmaraju, Manideepthi and Querec, Troy D. and Cleveland, Angela A. and Unger, Elizabeth R. and Markowitz, Lauri E.},
