@article{cdi_webofscience_primary_000384562700015CitationCount,
  title = {Estimating Carbon Storage in Windbreak Trees on {{U}}.{{S}}. Agricultural Lands},
  author = {Possu, William Ballesteros and Brandle, James R. and Domke, Grant M. and Schoeneberger, Michele and Blankenship, Erin},
  year = {2016},
